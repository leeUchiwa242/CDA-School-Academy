{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Flask backend (school-manager)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "run.py",
                "FLASK_DEBUG": "true",
                "SECRET_KEY": "dev-cda-secret-key",
                "JWT_SECRET_KEY": "dev-cda-jwt-secret-key"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "cwd": "${workspaceFolder}/backend"
        }
    ]
}
